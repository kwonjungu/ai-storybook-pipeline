# =============================================
# AI 동화 파이프라인 — .gitignore
# =============================================

# API 키 & 시크릿 (절대 커밋 금지!)
.env
client_secret.json
token_*.json

# 생성된 출력물 (12GB+, 로컬에서만 보관)
output/

# 미디어 파일
*.wav
*.mp3
*.mp4
*.avi

# PDF (교육과정 저작권 자료 + 활동지)
*.pdf
독후활동지 관련/

# 아카이브 (구버전 스크립트)
_archive/

# 폰트 (자동 다운로드 또는 별도 설치)
assets/fonts/*.ttf

# Python 캐시
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# 배치 작업 임시 파일
batch_*.jsonl

# OS 자동 생성 파일
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# 파이프라인 HTML 리포트 (로컬 전용)
pipeline_diagram.html

# ���������� ���� �α�
*.log

# 채널 내부 분석/진단 리포트 (로컬 전용, public repo 비공개)
_channel_audit.json
_channel_audit_backup_*.json
_audit_thumbs/
_rewrite_preview.md
개선설계계획서_*.md
채널진단보고서_*.md
활동지컨설팅보고서_*.md

# 토큰 백업까지 확실히 제외 (token_*.json 만으로는 token_id.json.bak 이 안 걸러짐)
token_*.json*

# 배치/운영 상태 파일 (로컬 전용 — 어디까지 올렸는지 기록)
_en_batch_log.json
_id_batch_log.json
_id_haru_batch_log.json
_revoice_reupload_log.json
_pipeline_queue.txt
_pipeline_done.txt
_next_schedule.txt
_dispatcher_stop

# 점검 리포트·썸네일 백업 (로컬 전용)
_thumb_c_audit*.json
_thumb_char_check.json
_voice_audit_report.json
_thumb_backup_*/
_tmp_*.py
