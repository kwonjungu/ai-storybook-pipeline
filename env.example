# ============================================================
# AI 동화책 파이프라인 — API 키 설정
# ============================================================
# 이 파일을 프로젝트 루트에 .env 로 복사하세요:
#   cp env.example .env
# 그리고 아래 키를 실제 값으로 교체하세요.
# .env 파일은 .gitignore에 포함되어 GitHub에 올라가지 않습니다.
# ============================================================

# 1. Google AI Studio — 이미지 생성 + TTS (Gemini)
#    발급: https://aistudio.google.com → 왼쪽 메뉴 "Get API key"
GEMINI_API_KEY=여기에_발급받은_Gemini_API_키를_붙여넣으세요

# 2. OpenAI — STT(Whisper) 등 보조 용도
#    발급: https://platform.openai.com/api-keys → "Create new secret key"
#    결제: https://platform.openai.com/settings/organization/billing
OPENAI_API_KEY=여기에_발급받은_OpenAI_API_키를_붙여넣으세요

# 3. Typecast — 한국어 TTS (ssfm-v30, 맥락 기반 보이스 캐스팅)
#    발급: https://studio.typecast.ai/developers/api
#    ※ 구 Supertone API는 2026-08-31 서비스 종료로 제거됨
TYPECAST_API_KEY=여기에_발급받은_Typecast_API_키를_붙여넣으세요
# TYPECAST_MODEL=ssfm-v30            # 기본값. 안정 우선 시 ssfm-v21

# 4. ElevenLabs — 다국어 TTS 폴백 (Gemini 쿼터 초과 시)
#    발급: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=여기에_발급받은_ElevenLabs_API_키를_붙여넣으세요
# ELEVEN_TTS_MODEL=eleven_v3         # 기본값. 구 모델 사용 시 eleven_multilingual_v2

# 5. (선택) Gemini 모델 오버라이드
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_FALLBACK_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_VISION_MODEL=gemini-2.5-flash
